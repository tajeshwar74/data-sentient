# Snowflake connection
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_STAGE=

# AI provider: auto, gemini, or openai
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage: local or snowflake
DATA_SENTIENT_STORAGE=local

# Comma-separated frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
